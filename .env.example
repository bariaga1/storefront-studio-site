# Consultant email (Resend). Use onboarding@resend.dev until you verify a domain.
RESEND_API_KEY=
CONSULTANT_EMAIL=
RESEND_FROM=Storefront Studio <onboarding@resend.dev>

# A separate PRIVATE repo that stores client folders. Never point this at the
# public code repo — inquiries include names, emails, and phone numbers.
# Token needs Contents: Read and write on that private repo only.
GITHUB_TOKEN=
GITHUB_REPO=your-github-user/storefront-studio-clients
GITHUB_BRANCH=main
